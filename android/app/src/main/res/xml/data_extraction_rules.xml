<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup + device-transfer contract for API 31+. Mirrors backup_rules.xml.
  Both cloud-backup and device-to-device transfer restore the SQLite file
  + SharedPreferences so the user's workout history survives a reinstall
  or upgrade to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="peak.sqlite" />
        <include domain="database" path="peak.sqlite-wal" />
        <include domain="database" path="peak.sqlite-shm" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="peak.sqlite" />
        <include domain="database" path="peak.sqlite-wal" />
        <include domain="database" path="peak.sqlite-shm" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
